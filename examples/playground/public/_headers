# Cloudflare Pages / Netlify static-header rules.
# Astro prerenders API routes to plain static files; Response headers from
# route handlers may be discarded by extension-based static serving.
# See docs/DECISIONS.md (static twin headers at the edge).

/raw/blog/*.md
  Content-Type: text/markdown; charset=utf-8
  Content-Disposition: inline
  X-Robots-Tag: noindex, follow
  X-Content-Type-Options: nosniff
  X-AEO-Version: 1.0
  Vary: Accept, User-Agent

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
