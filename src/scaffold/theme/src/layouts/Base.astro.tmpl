---
import { site } from "../../data/site.config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** Absolute URL of markdown twin when present (AEO §8.4.1 / llms.txt v2 rel=alternate). */
  markdownAlternate?: string;
  /** Absolute URL of the covering llms.txt index (llms.txt v2 rel=describedby). */
  describedBy?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | unknown[];
  /** Open Graph article protocol meta (only on post pages). */
  articleMeta?: {
    publishedTime: string;
    modifiedTime: string;
    author?: string;
    tags?: string[];
    section?: string;
  };
}
const { title, description, canonical, markdownAlternate, describedBy, image, noindex, jsonLd, articleMeta } = Astro.props;
const canon = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const rawImage = image || (site.seo as any)?.ogImage || "/media/og-default.png";
const ogImageUrl = rawImage
  ? (rawImage.startsWith('http://') || rawImage.startsWith('https://')
      ? rawImage
      : new URL(rawImage, Astro.site).href)
  : undefined;

// Twitter handle from site.social.twitter
const twitterHandle = ("social" in site && site.social && typeof site.social === "object" && (site.social as any).twitter)
  ? ((site.social as any).twitter as string)
  : undefined;
const twitterHandleFormatted = twitterHandle
  ? (twitterHandle.startsWith('@') ? twitterHandle : `@${twitterHandle.split('/').filter(Boolean).pop()}`)
  : undefined;

// Strip trailing slash so we can safely append asset paths.
const siteBase = site.baseUrl.replace(/\/?$/, "");
const preferredEnabled =
  (site as { preferredSources?: { enabled?: boolean } }).preferredSources?.enabled !== false;

// Organization JSON-LD — site-level entity signal (E-E-A-T).
const sameAs = "social" in site && site.social && typeof site.social === "object" && !Array.isArray(site.social)
  ? Object.values(site.social as Record<string, string>).filter(Boolean)
  : Array.isArray(site.social)
    ? (site.social as string[]).filter(Boolean)
    : [];
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.brand,
  url: `https://${site.domain}`,
  ...((site.logo || site.favicon) ? { logo: new URL(site.logo || site.favicon, Astro.site).href } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canon} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    <meta property="og:url" content={canon} />
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={title} />}
    {twitterHandleFormatted && <meta name="twitter:site" content={twitterHandleFormatted} />}
    {twitterHandleFormatted && <meta name="twitter:creator" content={twitterHandleFormatted} />}

    {/* Open Graph article protocol — freshness + attribution signals for search & AI engines. */}
    {articleMeta && <meta property="article:published_time" content={articleMeta.publishedTime} />}
    {articleMeta && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
    {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}
    {articleMeta?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    {articleMeta?.section && <meta property="article:section" content={articleMeta.section} />}

    <link rel="alternate" type="application/rss+xml" title="RSS" href={new URL("/rss.xml", Astro.site).href} />
    <link rel="alternate" type="text/plain" title="llms-full" href={new URL("/llms-full.txt", Astro.site).href} />
    {markdownAlternate && (
      <link rel="alternate" type="text/markdown" href={markdownAlternate} />
    )}
    {/* llms.txt v2: tells an agent which llms.txt covers this page (B2A nav file). */}
    {describedBy && (
      <link rel="describedby" href={describedBy} />
    )}

    {/* Brand favicon (set `favicon` in site.config). siteBase keeps it correct
        when mounted at a sub-path so it matches the host site's icon. */}
    {site.favicon && <link rel="icon" href={`${siteBase}${site.favicon}`} />}

    <!-- Brand tokens: absolute URLs so the blog loads them correctly when mounted
         at a sub-path (e.g. domain.com/blog). Regenerate with `glint theme pull`. -->
    <link rel="stylesheet" href={`${siteBase}/theme.css`} />
    <link rel="stylesheet" href={`${siteBase}/custom.css`} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Google Search Console + Bing Webmaster verification meta tags.
        Safe to emit on all pages (including dev) — they're inert meta tags. */}
    {site.verification?.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification?.bing && <meta name="msvalidate.01" content={site.verification.bing} />}

    {/* Google Preferred Sources — official publisher.js (Search Central 2026-08-20).
        Adds the current host and returns the reader to this page. Domain/subdomain
        only; a /blog mount is not its own source. */}
    {preferredEnabled && (
      <script is:inline async src="https://news.google.com/swg/js/v1/publisher.js"></script>
    )}

    {/* Google Analytics 4 — PROD only, and never on noindex/draft pages so
        preview deploys don't pollute production data. */}
    {import.meta.env.PROD && !noindex && site.analytics?.ga4 && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.ga4}`}></script>
    )}
    {import.meta.env.PROD && !noindex && site.analytics?.ga4 && (
      <script define:vars={{ gaId: site.analytics.ga4 }}>
        window.dataLayer = window.dataLayer || [];
        // GA4 expects the Arguments object (not a rest array).
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", gaId);
      </script>
    )}

    {/* Cloudflare Web Analytics — PROD only, skip noindex/draft previews. */}
    {import.meta.env.PROD && !noindex && site.analytics?.cloudflare && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: site.analytics.cloudflare })}
      ></script>
    )}
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
