---
import Base from "../layouts/Base.astro";
import { site } from "../../data/site.config";
import { pagePosts } from "../posts";
const posts = await pagePosts();
const description = site.seo.defaultDescription || `${site.brand} blog`;

// WebSite JSON-LD — helps search engines understand site structure + enables sitelinks search box.
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.brand,
  url: `https://${site.domain}`,
  potentialAction: {
    "@type": "SearchAction",
    target: new URL("/blog/search?q={search_term_string}", Astro.site).href,
    "query-input": "required name=search_term_string",
  },
};
---

<Base title={site.brand} description={description} jsonLd={webSiteSchema}>
  <h1>{site.brand}</h1>
  <ul>
    {
      posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          {p.data.draft && <em> — draft</em>}
          <p>{p.data.summary}</p>
        </li>
      ))
    }
  </ul>
</Base>
