import type { APIContext } from "astro";
import { site } from "../../data/site.config";

// SEO + AEO: per-brand AI crawler policy.
// "all" = allow everything; "retrieval-only" = block training bots, allow retrieval; "none" = block all AI bots.
// See .ai/docs/plans/seo-aeo-uplift.md §2.7

// Retrieval / user-action bots: answers & search (prefer allow when owner wants AI citations)
const RETRIEVAL_BOTS = [
  "OAI-SearchBot",    // OpenAI search
  "ChatGPT-User",     // ChatGPT user-triggered browse
  "Perplexity-User",  // Perplexity user answers
  "PerplexityBot",    // Perplexity crawl/index
  "Claude-User",      // Anthropic user-triggered
  "Claude-SearchBot", // Anthropic search
  "ClaudeBot",        // Anthropic crawler (often mixed purpose — treat as retrieval-allow)
];

// Training-oriented crawlers (block under retrieval-only / none)
const TRAINING_BOTS = [
  "GPTBot",           // OpenAI training
  "CCBot",            // Common Crawl
  "Google-Extended",  // Google generative AI opt-out (≠ Googlebot)
  "Applebot-Extended",
  "anthropic-ai",
  "Bytespider",
  "meta-externalagent",
];

function buildRobotsTxt(sitemapUrl: string, policy: string): string {
  const lines = [
    "User-agent: *",
    "Allow: /",
    "",
  ];

  if (policy === "retrieval-only") {
    lines.push("# AI retrieval bots (surface your content in answers)");
    for (const bot of RETRIEVAL_BOTS) {
      lines.push(`User-agent: ${bot}`, "Allow: /", "");
    }
    lines.push("# AI training bots (blocked by brand policy)");
    for (const bot of TRAINING_BOTS) {
      lines.push(`User-agent: ${bot}`, "Disallow: /", "");
    }
  } else if (policy === "none") {
    lines.push("# AI bots (all blocked by brand policy)");
    for (const bot of [...RETRIEVAL_BOTS, ...TRAINING_BOTS]) {
      lines.push(`User-agent: ${bot}`, "Disallow: /", "");
    }
  }
  // "all" → default User-agent: * Allow: / covers everything

  lines.push(`Sitemap: ${sitemapUrl}`, "");
  return lines.join("\n");
}

export async function GET(context: APIContext) {
  const sitemap = new URL("/sitemap-index.xml", context.site).href;
  const policy = (site as { aiCrawlers?: string }).aiCrawlers ?? "all";
  const body = buildRobotsTxt(sitemap, policy);
  return new Response(body, {
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  });
}
