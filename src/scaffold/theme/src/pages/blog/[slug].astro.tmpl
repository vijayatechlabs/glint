---
import { render } from "astro:content";
import { extractHeadings } from "@vijayatech/glint";
import Base from "../../layouts/Base.astro";
import { site } from "../../../data/site.config";
import { pagePosts, publicPosts, relatedTo, resolveAuthor } from "../../posts";

export async function getStaticPaths() {
  const posts = await pagePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const markdownAlternate = new URL(`/raw/blog/${post.id}.md`, Astro.site).href;
// llms.txt v2: the covering index for this page (same subpath tree, most-specific wins).
const describedBy = new URL(`/llms.txt`, Astro.site).href;

const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));
const related = relatedTo(post, await publicPosts());

// Author entity for JSON-LD (E-E-A-T). Resolves personId → data/team.json.
const authorResolved = post.data.author ? resolveAuthor(post.data.author) : undefined;
const authorPerson = authorResolved
  ? {
      "@type": "Person" as const,
      name: authorResolved.name,
      ...(authorResolved.url ? { url: authorResolved.url } : {}),
    }
  : undefined;

// Article protocol meta — freshness + attribution signals for search & AI engines.
const articleMeta = {
  publishedTime: post.data.publishedAt.toISOString(),
  modifiedTime: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  ...(authorResolved ? { author: authorResolved.name } : {}),
  ...(post.data.tags.length > 0 ? { tags: post.data.tags as string[] } : {}),
  ...(post.data.category ? { section: post.data.category } : {}),
};

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  mainEntityOfPage: url,
  ...(post.data.cover ? { image: new URL(post.data.cover.src, Astro.site).href } : {}),
  ...(authorPerson ? { author: authorPerson } : {}),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    // Home points to the main domain — the blog is embedded in the wider site.
    { "@type": "ListItem", position: 1, name: "Home", item: `https://${site.domain}` },
    { "@type": "ListItem", position: 2, name: post.data.title, item: url },
  ],
};

// FAQ JSON-LD — featured snippets + AI answers (optional per-post opt-in).
const faqSchema = post.data.faq && post.data.faq.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: post.data.faq.map((f: { q: string; a: string }) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

// HowTo JSON-LD — step-by-step rich results (optional per-post opt-in).
const howToSchema = post.data.howTo
  ? {
      "@context": "https://schema.org",
      "@type": "HowTo",
      name: post.data.howTo.name,
      ...(post.data.howTo.totalTime ? { totalTime: post.data.howTo.totalTime } : {}),
      step: post.data.howTo.steps.map((s: { name: string; text: string; url?: string }, i: number) => ({
        "@type": "HowToStep",
        position: i + 1,
        name: s.name,
        text: s.text,
        ...(s.url ? { url: s.url } : {}),
      })),
    }
  : null;

// Collect all JSON-LD blocks into one array.
const allJsonLd = [blogPosting, breadcrumb, ...(faqSchema ? [faqSchema] : []), ...(howToSchema ? [howToSchema] : [])];

// TOC — IDs match rehypeHeadingIds on rendered HTML.
const toc = extractHeadings(post.body ?? "");
---

<Base
  title={post.data.title}
  description={post.data.summary}
  canonical={url}
  markdownAlternate={markdownAlternate}
  describedBy={describedBy}
  image={post.data.cover?.src ?? `/og/${post.id}.svg`}
  noindex={post.data.draft}
  jsonLd={allJsonLd}
  articleMeta={articleMeta}
>
  {post.data.draft && <p><strong>⚠ DRAFT — not published (preview only)</strong></p>}
  <article data-pagefind-body>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={post.data.publishedAt.toISOString()}>
        {post.data.publishedAt.toISOString().slice(0, 10)}
      </time>
      · {readingTime} min read
      {post.data.category && <> · <a href={`/blog/category/${post.data.category}/`}>{post.data.category}</a></>}
    </p>
    {toc.length >= 3 && (
      <nav class="toc" aria-label="Table of contents">
        <h2>Contents</h2>
        <ul>
          {toc.map((h: { depth: number; text: string; id: string }) => (
            <li style={`margin-left: ${(h.depth - 2) * 1}em`}>
              <a href={`#${h.id}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <Content />
    {post.data.tags.length > 0 && (
      <p class="tags">
        {post.data.tags.map((t) => <a href={`/blog/tag/${t}/`}>#{t}</a>)}
      </p>
    )}
  </article>

  {related.length > 0 && (
    <aside class="related">
      <h2>Related</h2>
      <ul class="post-list">
        {related.map((p) => (
          <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
        ))}
      </ul>
    </aside>
  )}

  <p><a href="/">← All posts</a></p>
</Base>
